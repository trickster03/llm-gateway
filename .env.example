# llm-gateway configuration — copy to `.env` (which is git-ignored) for local use.

# ── Non-secret config (safe to commit as an example) ────────────────────────
UPSTREAM_BASE_URL=http://localhost:11434/v1   # Ollama default; point at vLLM / OpenAI as needed
RATE_PER_SEC=2
BURST=10
MAX_CONCURRENCY=8
CACHE_TTL_SEC=60
CACHE_MAX=512

# ── Secrets: do NOT put real values in a committed file ─────────────────────
# Local:  export UPSTREAM_API_KEY=... (or a git-ignored .env)
# AWS:    set SECRET_ID to a Secrets Manager secret holding JSON, e.g.
#         {"UPSTREAM_API_KEY": "sk-..."} — the app pulls it at startup (app/secrets.py).
# SECRET_ID=llm-gateway/prod
# AWS_REGION=ap-south-1
# UPSTREAM_API_KEY=
